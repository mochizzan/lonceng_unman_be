# =============================================================================
# Lonceng Unman Backend — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- Server ---
APP_NAME=lonceng_unman_be
APP_ENV=production
APP_PORT=3000
APP_HOST=0.0.0.0

# --- CORS ---
# Restrict to your actual domain in production
# Example: "https://yourdomain.com,https://www.yourdomain.com"
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type

# --- LMS Browser Automation ---
LMS_BASE_URL=https://elearning.universitasmandiri.ac.id
LMS_DASHBOARD_URL=https://elearning.universitasmandiri.ac.id/admin/
BROWSER_HEADLESS=true
# BROWSER_TIMEOUT caps page actions (Navigate, Element, Eval). 60s default.
BROWSER_TIMEOUT=60s
# DNS_TIMEOUT caps the LMS hostname pre-flight lookup. Raised 2s → 5s
# because Docker's internal DNS (127.0.0.11:53) needs 3-5s under heavy
# concurrent load before the retry (handled in Manager.CheckDNS) can
# succeed. Operators can still override with DNS_TIMEOUT env var.
DNS_TIMEOUT=5s

# --- Document Download ---
DOWNLOAD_DIR=./downloads
EXTRACT_DIR=./extracted
EVAL_DIR=./eval/ground_truth
PROFILE_BASE_DIR=./profiles

# --- Photo Cache ---
PHOTO_CACHE_TTL=15m

# --- Session Management ---
# SESSION_TTL raised 15m → 24h to amortize the per-NPM cold-start cost
# across an entire academic day. The 2h hard lifetime cap in
# session/manager.go still bounds memory.
SESSION_TTL=24h
MAX_SESSIONS=20

# --- Cold-start tuning (Tier-1 + Tier-2) ---
# These knobs replace hardcoded sleeps that previously added 8s + 3s + 3s
# of pure wait time per cold request. Defaults match production behavior.
PHOTO_RENDER_WAIT=3s    # was hardcoded 8s in student_profile_service
PHOTO_RETRY_WAIT=1s     # was hardcoded 3s in student_profile_service retry loop
SCRAPE_FORM_WAIT=2s     # was hardcoded 3s in browser/scraper.go
# BROWSER_LAUNCH_TIMEOUT caps the launcher.Launch() + Connect() window.
# Without this, go-rod's auto-download or a hung Chromium spawn can stall
# the entire cold path with no ceiling.
BROWSER_LAUNCH_TIMEOUT=60s

# --- Limits ---
MAX_BODY_SIZE=1MB
MAX_PDF_SIZE=50MB

# --- Eval Dashboard Auth ---
SECRET_KEY=your-secret-key-here
AUTO_LOGIN=false

# --- Timezone ---
TZ=Asia/Jakarta

# =============================================================================
# Build Metadata (optional, used during docker build)
# =============================================================================
# Set these when running: docker compose build --build-arg VERSION=1.0.0
# BUILD_TIME=2026-08-10T00:00:00Z
# VERSION=latest